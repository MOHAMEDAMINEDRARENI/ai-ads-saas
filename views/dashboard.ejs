<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@15.8.1/dist/nouislider.min.css">
</head>
<body>
    <!-- Loading Screen -->
    <div id="loading-screen" class="loading-screen hidden">
        <div class="loader">
            <div class="loader-circle"></div>
            <div class="loader-text">جاري التحميل...</div>
        </div>
    </div>

    <!-- Header -->
    <header class="main-header">
        <div class="header-left">
            <div class="brand">
                <div class="brand-icon">
                    <i class="fas fa-robot"></i>
                </div>
                <div class="brand-info">
                    <h1 class="brand-name">AI Ads Marketing</h1>
                    <span class="brand-tag">منصة ذكاء اصطناعي لإنشاء حملات تسويقية احترافية</span>
                </div>
            </div>
        </div>

         <div class="header-right">

    <div class="language-menu">

        <button class="language-btn" id="languageBtn">
            🌐
        </button>

        <div class="language-dropdown hidden" id="languageDropdown">

            <button class="language-item" data-lang="ar">
                🇩🇿 العربية
            </button>

            <button class="language-item" data-lang="fr">
                🇫🇷 Français
            </button>

            <button class="language-item" data-lang="en">
                🇬🇧 English
            </button>

        </div>

    </div>

    <button class="btn-subscribe-header" onclick="scrollToPricing()">
        <i class="fas fa-crown"></i>
        <span>اشترك الآن</span>
    </button>

</div>

            <div class="user-menu">
                <div class="user-info" onclick="toggleUserMenu()">
                    <img src="<%= user.avatar %>" alt="<%= user.name %>" class="user-avatar">
                    <div class="user-details">
                        <span class="user-name"><%= user.name %></span>
                        <span class="user-email"><%= user.email %></span>
                    </div>
                    <i class="fas fa-chevron-down"></i>
                </div>

                <div id="user-dropdown" class="user-dropdown hidden">
                    <div class="dropdown-item">
                        <span class="plan-badge plan-<%= user.plan %>">
                            <%= plans[user.plan]?.nameAr || 'مجاني' %>
                        </span>
                    </div>
                    <div class="dropdown-divider"></div>
                    <a href="/logout" class="dropdown-item logout">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>تسجيل الخروج</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Hero Section -->
        <section class="hero-section">
            <div class="hero-content">
                <h2 class="hero-title">
                    <i class="fas fa-magic"></i>
                    أنشئ حملات تسويق احترافية كاملة بالذكاء الاصطناعي
                </h2>
                <p class="hero-desc">
    منصة AI Ads Marketing تساعدك في إنشاء حملات تسويقية كاملة باستخدام الذكاء الاصطناعي.
    احصل على استراتيجية احترافية، نصوص إعلانية جاهزة، Scripts فيديو، Hooks قوية،
    وأيضًا Prompts لإنشاء صور وفيديوهات AI لحملاتك الإعلانية.
</p>

                <div class="hero-stats">
                    <div class="stat-card">
                        <i class="fas fa-users"></i>
                        <div class="stat-number">+1000</div>
                        <div class="stat-label">مستخدم نشط</div>
                    </div>
                    <div class="stat-card">
                        <i class="fas fa-ad"></i>
                        <div class="stat-number">+5000</div>
                        <div class="stat-label">حملة إعلانية</div>
                    </div>
                    
                </div>
            </div>
            <div class="hero-visual">
                <div class="floating-cards">
                    <div class="float-card card-1">
                        <i class="fab fa-instagram"></i>
                        <span>Instagram Ads</span>
                    </div>
                    <div class="float-card card-2">
                        <i class="fab fa-facebook"></i>
                        <span>Facebook Ads</span>
                    </div>
                    <div class="float-card card-3">
                        <i class="fas fa-chart-pie"></i>
                        <span>Analytics</span>
                    </div>
                    <div class="float-card card-4">
                        <i class="fas fa-brain"></i>
                        <span>AI Strategy</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Strategy Generator Form -->
        <section class="strategy-section">
            <div class="section-header">
                <h3 class="section-title">
                    <i class="fas fa-wand-magic-sparkles"></i>
                    مولد الحملات التسويقية بالذكاء الاصطناعي
                </h3>
                <p class="section-desc">أدخل معلومات مشروعك وسنقوم بإنشاء حملة تسويقية كاملة تشمل الاستراتيجية والنصوص وScripts الفيديو وPrompts الذكاء الاصطناعي</p>
                <div class="plan-info">
                    <span class="current-plan">خطتك الحالية: <strong><%= plans[user.plan]?.nameAr || 'مجاني' %></strong></span>
                    <span class="strategies-used">استراتيجيات مستخدمة: <strong><%= user.strategyCount %></strong> / 
                        <%= plans[user.plan]?.limit === Infinity ? 'غير محدود' : plans[user.plan]?.limit %>
                    </span>
                </div>
            </div>

            <form id="strategy-form" class="strategy-form">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="project-name">
                            <i class="fas fa-briefcase"></i>
                            اسم المشروع
                        </label>
                        <input type="text" id="project-name" name="project_name" required 
                               placeholder="أدخل اسم مشروعك">
                    </div>

                    <div class="form-group">
                        <label for="target-audience">
                            <i class="fas fa-users"></i>
                            الجمهور المستهدف
                        </label>
                        <input type="text" id="target-audience" name="target_audience" required 
                               placeholder="مثال: الشباب المهتمين بالتقنية">
                    </div>
<div class="form-group">

    <label>
        <i class="fas fa-user-clock"></i>
        الفئة العمرية المستهدفة
    </label>

    <div class="age-range-container">

        <div class="age-input">

            <label for="age-from">من العمر</label>

            <input
                type="number"
                id="age-from"
                min="18"
                max="65"
                value="18"
                required
            >

        </div>

        <div class="age-input">

            <label for="age-to">إلى العمر</label>

            <input
                type="number"
                id="age-to"
                min="18"
                max="65"
                value="65"
                required
            >

        </div>

    </div>
<p id="age-error" class="age-error"></p>
    <input
        type="hidden"
        id="age-group"
        name="age_group"
        value="18-65"
    >

</div>
                    <div class="form-group">
                        <label for="target-country">
                            <i class="fas fa-globe"></i>
                            الدولة المستهدفة
                        </label>
                        <select id="target-country" name="target_country" required>
                            <option value="DZ" selected>🇩🇿 الجزائر (Algeria)</option>
                        </select>
                        <small class="form-hint">الخدمة متاحة حالياً فقط في الجزائر</small>
                    </div>

                    <div class="form-group">
                        <label for="platform">
                            <i class="fas fa-share-nodes"></i>
                            المنصة
                        </label>
                        <select id="platform" name="platform" required>
                            <option value="">اختر المنصة</option>
                            <option value="instagram">📸 Instagram Ads</option>
                            <option value="facebook">📘 Facebook Ads</option>
                            <option value="both">🌐 Instagram + Facebook</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="daily-budget">
                            <i class="fas fa-dollar-sign"></i>
                            الميزانية اليومية (بالدولار)
                        </label>
                        <input type="number" id="daily-budget" name="daily_budget" required 
                               min="1" step="0.01" placeholder="مثال: 50">
                    </div>

                    <div class="form-group">
                        <label for="campaign-days">
                            <i class="fas fa-calendar-alt"></i>
                            عدد أيام الحملة
                        </label>
                        <input type="number" id="campaign-days" name="campaign_days" required 
                               min="1" max="365" placeholder="مثال: 30">
                    </div>

                    <div class="form-group full-width">
                        <label for="project-desc">
                            <i class="fas fa-align-left"></i>
                            وصف المشروع / المنتج
                        </label>
                        <textarea id="project-desc" name="project_desc" rows="3" required
                                  placeholder="صف منتجك أو خدمتك باختصار..."></textarea>
                    </div>
                </div>

                <button type="submit" class="btn-generate" id="generate-btn">
                    <i class="fas fa-wand-magic-sparkles"></i>
                    <span>إنشاء حملة تسويق كاملة بالذكاء الاصطناعي</span>
                    <div class="btn-shine"></div>
                </button>
            </form>

            <!-- Strategy Result -->
            <div id="strategy-result" class="strategy-result hidden">
                <div class="result-header">
                    <i class="fas fa-check-circle"></i>
                    <h4>تم إنشاء الحملة التسويقية بنجاح!</h4>
                </div>
                <div id="strategy-content" class="result-content"></div>
                <div class="result-actions">
                    <button class="btn-copy" onclick="copyStrategy()">
                        <i class="fas fa-copy"></i>
                        نسخ الحملة كاملة
                    </button>
                    <button class="btn-download" onclick="downloadStrategy()">
                        <i class="fas fa-download"></i>
                        تحميل PDF
                    </button>
                </div>
            </div>
        </section>

        <!-- How It Works -->
        <section class="how-it-works">
            <h3 class="section-title">
                <i class="fas fa-lightbulb"></i>
                كيف تنشئ حملتك التسويقية بالذكاء الاصطناعي؟
            </h3>
            <div class="steps-grid">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <i class="fas fa-edit"></i>
                    <h4>أدخل المعلومات</h4>
                    <p>أدخل معلومات مشروعك والجمهور المستهدف والميزانية</p>
                </div>
                <div class="step-card">
                    <div class="step-number">2</div>
                    <i class="fas fa-brain"></i>
                    <h4>تحليل الذكاء الاصطناعي</h4>
                    <p>يقوم نظامنا بتحليل البيانات وإنشاء استراتيجية مخصصة</p>
                </div>
                <div class="step-card">
                    <div class="step-number">3</div>
                    <i class="fas fa-rocket"></i>
                    <h4>احصل على محتوى الحملة</h4>
                    <p>احصل على استراتيجية ونصوص إعلانية وScripts فيديو وPrompts AI جاهزة للاستخدام</p>
                </div>
                <div class="step-card">
                    <div class="step-number">4</div>
                    <i class="fas fa-chart-line"></i>
                    <h4>تحقيق الأرباح</h4>
                    <p>تابع أداء حملتك وزيادة أرباحك بشكل مستمر</p>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section id="pricing-section" class="pricing-section">
            <h3 class="section-title">
                <i class="fas fa-tags"></i>
                خطط الأسعار
            </h3>
            <p class="section-desc">اختر الخطة المناسبة لاحتياجاتك</p>

            <div class="pricing-grid">
                <% Object.values(plans).forEach(plan => { %>
                <div class="pricing-card <%= plan.id === 'plus' ? 'popular' : '' %> <%= plan.id === 'annual' ? 'best-value' : '' %> <%= user.plan === plan.id ? 'current' : '' %>">
                    <% if (plan.id === 'plus') { %>
                        <div class="popular-badge">الأكثر شعبية</div>
                    <% } %>
                    <% if (plan.id === 'annual') { %>
                        <div class="best-value-badge">أفضل قيمة</div>
                    <% } %>
                    <% if (user.plan === plan.id) { %>
                        <div class="current-badge">خطتك الحالية</div>
                    <% } %>

                    <div class="pricing-header">
                        <h4 class="plan-name"><%= plan.name %></h4>
                        <div class="plan-price">
                            <span class="price"><%= plan.price.toLocaleString() %></span>
                            <span class="currency">دج</span>
                        </div>
                        <span class="plan-period">
                            <%= plan.period === 'usage' ? 'مجاني' : plan.period === 'monthly' ? '/ شهر' : '/ سنة' %>
                        </span>
                    </div>
                    <div class="pricing-body">
                        <ul class="features-list">
                            <% plan.features.forEach(feature => { %>
                                <li><i class="fas fa-check"></i> <%= feature %></li>
                            <% }) %>
                            <% plan.disabledFeatures.forEach(feature => { %>
                                <li class="disabled"><i class="fas fa-times"></i> <%= feature %></li>
                            <% }) %>
                        </ul>
                    </div>
                    <button class="btn-plan <%= plan.id === 'plus' ? 'btn-popular' : plan.id === 'annual' ? 'btn-annual' : '' %>" 
                            onclick="subscribe('<%= plan.id %>')"
                            <%= user.plan === plan.id ? 'disabled' : '' %>>
                        <%= user.plan === plan.id ? 'مشترك حالياً' : plan.price === 0 ? 'ابدأ مجاناً' : 'اشترك الآن' %>
                    </button>
                </div>
                <% }) %>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-content">
            <div class="footer-brand">
                <i class="fas fa-robot"></i>
                <span>AI Ads Marketing</span>
            </div>
            <p class="copyright">
                Copyright © 2026 AI Ads Marketing | Coded by Mohamed Amine Drareni
            </p>
            <div class="footer-links">
    <a href="https://www.instagram.com/ami_nedrn/" target="_blank">
        <i class="fab fa-instagram"></i>
    </a>


    <a href="https://wa.me/213796315102" target="_blank">
        <i class="fab fa-whatsapp"></i>
    </a>

    <a href="https://www.tiktok.com/@ami_nedrn" target="_blank">
        <i class="fab fa-tiktok"></i>
    </a>
</div>
        </div>
    </footer>

    <!-- Payment Modal -->
    <div id="payment-modal" class="modal hidden">
        <div class="modal-overlay" onclick="closePaymentModal()"></div>
        <div class="modal-content">
            <button class="modal-close" onclick="closePaymentModal()">
                <i class="fas fa-times"></i>
            </button>

            <div class="payment-header">
                <i class="fas fa-credit-card"></i>
                <h3>إتمام الدفع</h3>
                <p id="payment-plan-name">الخطة المختارة</p>
            </div>

            <div class="payment-details">
                <div class="payment-row">
                    <span>الخطة</span>
                    <span id="modal-plan-name">Plus</span>
                </div>
                <div class="payment-row">
                    <span>السعر</span>
                    <span id="modal-plan-price">2,500 دج</span>
                </div>
                <div class="payment-row total">
                    <span>الإجمالي</span>
                    <span id="modal-total">2,500 دج</span>
                </div>
            </div>

            <div class="payment-method">
                <h4><i class="fas fa-shield-alt"></i> بوابة الدفع الآمنة</h4>
                <div class="chargily-badge">
                    <span class="chargily-logo">Chargily Pay</span>
                    <small>الدفع بالدينار الجزائري</small>
                </div>
            </div>

            <form id="payment-form" class="payment-form">
                <div class="form-group">
                    <label>الاسم الكامل</label>
                    <input type="text" id="payment-name" required placeholder="أدخل اسمك الكامل">
                </div>
                <div class="form-group">
                    <label>رقم الهاتف</label>
                    <input type="tel" id="payment-phone" required placeholder="05XX XX XX XX">
                </div>
                <div class="form-group">
                    <label>البريد الإلكتروني</label>
                    <input type="email" id="payment-email" required placeholder="your@email.com" value="<%= user.email %>">
                </div>

                <button type="submit" class="btn-pay">
                    <i class="fas fa-lock"></i>
                    <span>الدفع الآن عبر Chargily</span>
                </button>
            </form>

            <div class="payment-security">
                <i class="fas fa-lock"></i>
                <span>جميع المعاملات مشفرة وآمنة</span>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div id="success-modal" class="modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-content success-content">
            <div class="success-animation">
                <i class="fas fa-check-circle"></i>
            </div>
            <h3>تم الاشتراك بنجاح!</h3>
            <p>تم تأكيد عملية الدفع. يمكنك الآن استخدام جميع مميزات النظام.</p>
            <button class="btn-success" onclick="closeSuccessModal()">
                ابدأ الآن
            </button>
        </div>
    </div>

    <!-- Toast -->
    <div id="toast" class="toast hidden">
        <i class="fas fa-info-circle"></i>
        <span id="toast-message">رسالة</span>
    </div>

    <script>
    // User data from server
    const currentUser = <%- JSON.stringify(user) %>;
    const plansConfig = <%- JSON.stringify(plans) %>;
</script>
    <script src="https://cdn.jsdelivr.net/npm/nouislider@15.8.1/dist/nouislider.min.js"></script>
    <script src="/js/app.js"></script>
</body>
</html>